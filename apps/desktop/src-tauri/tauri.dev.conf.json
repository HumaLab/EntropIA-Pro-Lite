{
  "identifier": "com.entropia.pro.desktop.dev",
  "app": {
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$DATA/com.entropia.shared/**/*", "$LOCALDATA/com.entropia.shared/**/*"]
      }
    },
    "windows": [
      {
        "title": "EntropIA Lite",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ]
  }
}

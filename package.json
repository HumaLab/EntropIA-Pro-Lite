{
  "name": "entropia-pro",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9 <10"
  },
  "scripts": {
    "binaries:check": "node apps/desktop/scripts/verify-binaries.mjs check",
    "binaries:verify-upstream": "node apps/desktop/scripts/verify-binaries.mjs verify-upstream",
    "dev": "turbo dev",
    "build": "turbo build",
    "desktop:dev:isolated": "pnpm --filter @entropia-pro/desktop tauri:dev:isolated",
    "desktop:build:isolated": "pnpm --filter @entropia-pro/desktop tauri:build:isolated",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write apps/desktop/src packages/ui/src packages/store/src packages/store/scripts",
    "format:check": "prettier --check apps/desktop/src packages/ui/src packages/store/src packages/store/scripts",
    "test": "turbo test",
    "test:run": "turbo test -- --run",
    "test:ui": "vitest --ui",
    "version:check": "node apps/desktop/scripts/version.mjs check",
    "version:bump": "node apps/desktop/scripts/version.mjs bump",
    "rust:quality:report": "node apps/desktop/scripts/run-powershell.mjs ./apps/desktop/src-tauri/scripts/rust-quality-contract.ps1"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "eslint": "^9",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "happy-dom": "^20.8.9",
    "prettier": "^3",
    "prettier-plugin-svelte": "^3",
    "svelte-eslint-parser": "^1.10.0",
    "turbo": "^2",
    "typescript": "^6",
    "typescript-eslint": "^8",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "prosemirror-view": "^1.42.3",
      "markdown-it": "^14.3.3"
    }
  }
}
